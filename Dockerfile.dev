# Dockerfile para ambiente de DESENVOLVIMENTO
# Não faz build de produção nem define ENTRYPOINT — o comando de dev
# (npm install / npm run dev) vem do docker-compose.
FROM node:24

WORKDIR /app-node

# Instala as dependências na construção da imagem para servir de baseline.
# Em runtime o compose reexecuta "npm install" após montar o volume,
# garantindo que o node_modules fique consistente com o host.
COPY package*.json ./
RUN npm install

EXPOSE 3000
